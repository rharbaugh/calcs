---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Useful calculators for Tibia players.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-content">
        <a class="brand" href={base}>Tibia Calculators</a>
        <nav aria-label="Main navigation">
          <a href={`${base}calculators/speed/`}>Speed</a>
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">Unofficial fan-made tools for Tibia players.</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: #111827;
    color: #e5e7eb;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  a { color: #7dd3fc; }
  a:hover { color: #bae6fd; }
  .shell { width: min(100% - 2rem, 68rem); margin-inline: auto; }
  .site-header { border-bottom: 1px solid #334155; background: #0f172a; }
  .header-content { min-height: 4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { color: #f8fafc; font-weight: 750; text-decoration: none; }
  nav { display: flex; gap: 1rem; }
  nav a { text-decoration: none; }
  main { min-height: calc(100vh - 8rem); padding-block: 3rem; }
  .site-footer { border-top: 1px solid #334155; color: #94a3b8; font-size: 0.875rem; padding-block: 1.5rem; }
  .eyebrow { color: #67e8f9; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; margin: 0.5rem 0 1rem; }
  .lede { color: #cbd5e1; font-size: 1.15rem; line-height: 1.6; max-width: 44rem; }
  .card { border: 1px solid #334155; border-radius: 0.75rem; background: #172033; padding: 1.5rem; }
  .card h2 { margin-top: 0; }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; margin-top: 2rem; }
  .coming-soon { color: #a5f3fc; }
</style>
