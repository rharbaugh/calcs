---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tibia Calcs" description="Look up a Tibia character and use focused calculators.">
  <section class="character-lookup-modal" id="character-lookup" aria-label="Character lookup" hidden>
    <div class="character-lookup" role="dialog" aria-modal="true">
      <button class="lookup-close" id="lookup-close" type="button" aria-label="Close character lookup">×</button>
      <p class="eyebrow">Character lookup</p>
      <form id="character-form" class="lookup-form">
        <label for="character-name">Character name</label>
        <div class="lookup-controls">
          <div class="lookup-input-wrap">
            <input id="character-name" name="name" type="text" autocomplete="off" placeholder="Eternal Oblivion" aria-autocomplete="list" aria-controls="character-suggestions" aria-expanded="false" required />
            <div class="character-suggestions" id="character-suggestions" role="listbox" hidden></div>
          </div>
          <button type="submit">Look up</button>
        </div>
        <p class="lookup-note">Searches public character data from Tibia.</p>
      </form>
      <p id="lookup-error" class="lookup-error" role="alert" hidden></p>
    </div>
  </section>

  <section class="character-profile" id="character-profile" hidden aria-live="polite">
    <div class="profile-heading">
      <div class="profile-identity">
        <h1 id="profile-name"></h1>
      </div>
      <div class="profile-links">
        <a id="official-character-link" class="official-link" href="https://www.tibia.com" target="_blank" rel="noreferrer">View on Tibia.com ↗</a>
        <a id="guildstats-character-link" class="official-link" href="https://guildstats.eu" target="_blank" rel="noreferrer">View on GuildStats ↗</a>
      </div>
    </div>
    <div class="profile-overview">
      <div><span>Level</span><strong id="profile-level"></strong></div>
      <div><span>Vocation</span><strong id="profile-vocation"></strong></div>
      <div class="profile-hp"><span><i aria-hidden="true">♥</i> HP</span><strong id="profile-hp"></strong></div>
      <div class="profile-mana"><span><i aria-hidden="true">✦</i> Mana</span><strong id="profile-mana"></strong></div>
      <div class="profile-capacity"><span><i aria-hidden="true">◆</i> Capacity</span><strong id="profile-capacity"></strong></div>
      <div><span>World</span><strong id="profile-world"></strong></div>
      <div><span>Residence</span><strong id="profile-residence"></strong></div>
      <div><span>Account</span><strong id="profile-status"></strong></div>
    </div>
  </section>

  <section class="card-grid" id="character-calculators" aria-label="Character calculators" hidden>
    <article class="card speed-calculator" aria-labelledby="speed-title">
      <div class="speed-heading">
        <h2 id="speed-title">Speed Calculator</h2>
        <p class="speed-total">Displayed speed <strong id="speed-total">—</strong></p>
      </div>
      <div class="speed-layout">
        <div class="speed-options-panel">
          <fieldset>
          <legend>Haste spell</legend>
          <div class="spell-options" id="spell-options"></div>
          </fieldset>
          <fieldset>
          <legend>Boots</legend>
          <div class="choice-options" id="boot-options"></div>
          </fieldset>
          <fieldset id="imbuement-fieldset">
          <legend>Boot imbuement</legend>
          <div class="choice-options" id="imbuement-options"></div>
          </fieldset>
          <fieldset>
          <legend>Other bonuses</legend>
          <div class="choice-options">
            <label class="choice-option"><input type="checkbox" data-speed-item="30" /><img id="time-ring-icon" alt="" /><span>Time Ring<small><b>+30</b> speed</small></span></label>
            <label class="choice-option"><input type="checkbox" data-speed-item="10" /><img id="draptor-mount-icon" alt="" /><span>Mount<small><b>+10</b> speed</small></span></label>
          </div>
          </fieldset>
        </div>
        <div class="speed-tiles-panel">
          <div class="speed-chart-wrap">
            <table class="speed-chart">
          <thead><tr><th>Tile type</th><th>Breakpoint</th><th>Move time</th><th>To next</th></tr></thead>
          <tbody id="speed-chart-body"></tbody>
        </table>
          </div>
          <p class="speed-note">Hover a tile image for breakpoint advice.</p>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .character-lookup, .character-profile { border: 1px solid #626262; background: #484848; box-shadow: inset 1px 1px #555, 1px 1px #2b2b2b; padding: 1.25rem 1.5rem; }
  .character-lookup-modal { position: fixed; z-index: 25; inset: 0; display: grid; place-items: start center; padding: 5rem 1rem 1rem; background: rgba(0, 0, 0, 0.55); }
  .character-lookup { position: relative; width: min(100%, 52rem); }
  .lookup-close { position: absolute; top: 0.55rem; right: 0.65rem; width: 1.75rem; height: 1.75rem; padding: 0; color: #cfcfcf; font-size: 1rem; line-height: 1; }
  .character-lookup h1, .profile-heading h1 { font-size: 1.15rem; line-height: 1.15; margin: 0.3rem 0 0.9rem; }
  .profile-heading h1 { margin-bottom: 0; }
  label, .lookup-note { color: #c8c8c8; font-size: 0.76rem; }
  .lookup-controls { display: flex; gap: 0.5rem; margin-top: 0.35rem; }
  .lookup-input-wrap { position: relative; display: flex; min-width: 0; flex: 1; }
  .lookup-input-wrap input { width: 100%; }
  .character-suggestions { position: absolute; z-index: 2; top: calc(100% + 1px); right: 0; left: 0; border: 1px solid #696969; background: #303030; box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.45); }
  :global(.character-suggestion) { display: block; width: 100%; margin: 0; border: 0; border-bottom: 1px solid #454545; padding: 0.45rem 0.6rem; background: transparent; box-shadow: none; color: #e5e5e5; text-align: left; }
  :global(.character-suggestion:last-child) { border-bottom: 0; }
  :global(.character-suggestion:hover), :global(.character-suggestion:focus) { background: #505050; outline: 0; }
  input, button { border: 1px solid #222; border-radius: 0; font: 700 0.78rem Tahoma, Verdana, Arial, sans-serif; }
  input { min-width: 0; flex: 1; padding: 0.5rem 0.6rem; background: #303030; box-shadow: inset 1px 1px #1c1c1c; color: #eee; }
  input::placeholder { color: #929292; }
  button { padding: 0.5rem 0.75rem; background: #5a5a5a; box-shadow: inset 1px 1px #6c6c6c; color: #f1f1f1; cursor: pointer; }
  button:hover, button:focus { background: #666; outline: 1px solid #929292; outline-offset: -1px; }
  .lookup-note { margin: 0.55rem 0 0; }
  .lookup-error { color: #f0b7b7; font-size: 0.78rem; margin: 0.8rem 0 0; }
  .character-profile { margin-top: 1.5rem; }
  .profile-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #606060; padding-bottom: 0.7rem; }
  .profile-identity { display: flex; align-items: baseline; gap: 0.55rem; }
  .profile-heading .eyebrow { margin: 0; }
  .profile-heading h1 { margin: 0; }
  .profile-links { display: flex; flex-wrap: wrap; justify-content: end; gap: 0.75rem; }
  .official-link { flex: none; font-size: 0.72rem; white-space: nowrap; }
  .profile-overview { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1px; margin-top: 0.85rem; background: #333; border: 1px solid #333; }
  .profile-overview div { padding: 0.55rem 0.7rem; background: #414141; }
  .profile-overview span, dt { color: #bababa; font-size: 0.74rem; }
  .profile-overview i { font-style: normal; font-size: 0.68rem; }
  .profile-hp span, .profile-hp strong { color: #edc0c0; }
  .profile-hp i { color: #dc5a5a; }
  .profile-mana span, .profile-mana strong { color: #c5dbf2; }
  .profile-mana i { color: #6ca8e8; }
  .profile-capacity span, .profile-capacity strong { color: #e3d4aa; }
  .profile-capacity i { color: #d0ad59; }
  .profile-overview strong { display: block; color: #f2f2f2; font-size: 0.9rem; margin-top: 0.3rem; white-space: nowrap; }
  .card-grid { margin-top: 1.5rem; }
  .speed-calculator { padding: 1.15rem; }
  .speed-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .speed-heading .eyebrow { margin: 0; }
  .speed-heading h2 { font-size: 1rem; margin: 0.3rem 0 0; }
  .speed-total { color: #c7c7c7; font-size: 0.76rem; margin: 0; white-space: nowrap; }
  .speed-total strong { color: #f2f2f2; font-size: 1rem; margin-left: 0.25rem; }
  .speed-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem; margin-top: 0.85rem; }
  .speed-options-panel { display: grid; align-content: start; gap: 0.75rem; }
  .speed-tiles-panel { padding-top: 0.5rem; }
  fieldset { min-width: 0; margin: 0; border: 1px solid #5d5d5d; padding: 0.6rem; }
  legend { color: #c5c5c5; font-size: 0.7rem; padding-inline: 0.25rem; }
  .spell-options { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .choice-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.3rem; }
  :global(.spell-option) { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.65rem; border: 1px solid #292929; padding: 0.3rem 0.5rem; background: #3d3d3d; color: #d8d8d8; font-size: 0.7rem; cursor: pointer; }
  :global(.spell-option:has(input:checked)) { border-color: #7796b8; background: #485567; color: #fff; }
  :global(.spell-option input) { width: 13px; height: 13px; flex: none; margin: 0; accent-color: #7796b8; }
  :global(.choice-option) { display: flex; align-items: center; gap: 0.45rem; min-width: 0; min-height: 2.9rem; padding: 0.35rem 0.45rem; border: 1px solid #292929; background: #3d3d3d; color: #d8d8d8; font-size: 0.68rem; cursor: pointer; }
  :global(.choice-option:has(input:checked)) { border-color: #7796b8; background: #485567; color: #fff; }
  :global(.choice-option:has(input:disabled)) { cursor: not-allowed; opacity: 0.45; }
  :global(.choice-option input) { width: 13px; height: 13px; flex: none; margin: 0; accent-color: #7796b8; }
  :global(.choice-option img), :global(.spell-option img) { width: 32px; height: 32px; flex: none; object-fit: contain; image-rendering: pixelated; }
  :global(.choice-option span) { min-width: 0; line-height: 1.2; }
  :global(.choice-option small) { display: block; color: #aaa; font-size: 0.6rem; margin-top: 0.12rem; }
  :global(.choice-option b) { color: #9cc4ec; font-size: 0.62rem; }
  .speed-chart-wrap { overflow-x: auto; border: 1px solid #5d5d5d; }
  .speed-chart { width: 100%; min-width: 28rem; border-collapse: collapse; font-size: 0.72rem; }
  .speed-chart :global(th) { background: #3d3d3d; color: #bbb; font-size: 0.65rem; font-weight: 700; text-align: left; text-transform: uppercase; }
  .speed-chart :global(th), .speed-chart :global(td) { height: 2.75rem; border-bottom: 1px solid #555; padding: 0.45rem 0.75rem; vertical-align: middle; white-space: nowrap; }
  .speed-chart :global(th:first-child), .speed-chart :global(td:first-child) { padding-left: 0.75rem; }
  .speed-chart :global(tr) { background: #454545; }
  .speed-chart tbody :global(tr:hover) { background: #525252; }
  .speed-chart :global(.breakpoint) { color: #e2d49c; font-weight: 700; }
  .speed-chart :global(.next-speed) { color: #a7c9ec; }
  :global(.tile-name) { display: inline-flex; align-items: center; gap: 0.65rem; line-height: 1.2; }
  :global(.tile-advice) { position: relative; display: inline-flex; align-items: center; flex: none; cursor: help; }
  :global(.tile-advice img) { display: block; width: 32px; height: 32px; image-rendering: pixelated; }
  :global(.tile-advice::after) { position: absolute; z-index: 3; left: -0.5rem; bottom: calc(100% + 0.45rem); display: none; width: 16rem; padding: 0.5rem; border: 1px solid #777; background: #303030; box-shadow: 2px 2px 0 rgba(0,0,0,.45); color: #eee; content: attr(data-advice); font-size: 0.68rem; line-height: 1.35; white-space: normal; }
  :global(.tile-advice:hover::after), :global(.tile-advice:focus::after) { display: block; }
  .speed-note { color: #aaa; font-size: 0.68rem; margin: 0.65rem 0 0; }
  .speed-diff { font-weight: 700; }
  .speed-diff.away { color: #ef9a9a; }
  .speed-diff.max { color: #a8d89e; }
  @media (max-width: 62rem) {
    .profile-overview { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .speed-layout { grid-template-columns: 1fr; }
    .speed-tiles-panel { padding-top: 0; }
  }
  @media (max-width: 48rem) {
    .character-profile { margin-top: 1rem; padding: 1rem; }
    .profile-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .profile-overview div { padding: 0.5rem 0.55rem; }
    .speed-calculator { padding: 0.85rem; }
  }
  @media (max-width: 36rem) {
    .profile-heading, .lookup-controls { display: block; }
    .profile-identity { display: flex; }
    button { margin-top: 0.5rem; }
    .profile-links { justify-content: start; margin-top: 0.75rem; }
    .profile-overview { gap: 1px; }
    .speed-heading { align-items: start; }
    .choice-options { grid-template-columns: 1fr; }
    .spell-options { gap: 0.3rem; }
    :global(.spell-option) { min-height: 2.45rem; padding: 0.25rem 0.4rem; }
    :global(.choice-option) { min-height: 2.75rem; }
  }
  @media (max-width: 25rem) {
    .profile-overview { grid-template-columns: 1fr; }
    .speed-calculator { padding: 0.7rem; }
    .speed-chart th, .speed-chart td { padding-inline: 0.55rem; }
  }
</style>

<script>
  type Character = {
    name: string; level: number; vocation: string; world: string; sex: string; residence: string;
    achievement_points: number; account_status: string; unlocked_titles: number; last_login: string;
  };
  type CharacterLookupResponse = {
    character?: { character?: Character; other_characters?: { name?: string }[] };
  };

  const form = document.querySelector<HTMLFormElement>('#character-form')!;
  const input = document.querySelector<HTMLInputElement>('#character-name')!;
  const suggestions = document.querySelector<HTMLElement>('#character-suggestions')!;
  const error = document.querySelector<HTMLElement>('#lookup-error')!;
  const lookup = document.querySelector<HTMLElement>('#character-lookup')!;
  const profile = document.querySelector<HTMLElement>('#character-profile')!;
  const calculators = document.querySelector<HTMLElement>('#character-calculators')!;
  const spellOptions = document.querySelector<HTMLElement>('#spell-options')!;
  const speedTotal = document.querySelector<HTMLElement>('#speed-total')!;
  const speedChart = document.querySelector<HTMLElement>('#speed-chart-body')!;
  const bootOptions = document.querySelector<HTMLElement>('#boot-options')!;
  const imbuementOptions = document.querySelector<HTMLElement>('#imbuement-options')!;
  const imbuementFieldset = document.querySelector<HTMLFieldSetElement>('#imbuement-fieldset')!;
  const itemToggles = [...document.querySelectorAll<HTMLInputElement>('[data-speed-item]')];
  let speedCharacter: Character | undefined;
  const suggestionKey = 'tibia-calcs:character-suggestions:v1';

  const suggestionNames = () => {
    try {
      const saved = JSON.parse(localStorage.getItem('tibia-calcs:characters:v1') ?? '[]') as Character[];
      const related = JSON.parse(localStorage.getItem(suggestionKey) ?? '[]') as string[];
      return [...new Set([...saved.map((character) => character.name), ...related])].filter(Boolean);
    } catch {
      return [];
    }
  };
  const closeSuggestions = () => {
    suggestions.hidden = true;
    input.setAttribute('aria-expanded', 'false');
  };
  const renderSuggestions = () => {
    const query = input.value.trim().toLocaleLowerCase();
    const matches = query ? suggestionNames().filter((name) => name.toLocaleLowerCase().includes(query) && name.toLocaleLowerCase() !== query).slice(0, 8) : [];
    suggestions.replaceChildren(...matches.map((name) => {
      const option = document.createElement('button');
      option.className = 'character-suggestion';
      option.type = 'button';
      option.role = 'option';
      option.textContent = name;
      option.addEventListener('click', () => {
        input.value = name;
        closeSuggestions();
        input.focus();
      });
      return option;
    }));
    suggestions.hidden = matches.length === 0;
    input.setAttribute('aria-expanded', String(matches.length > 0));
  };
  input.addEventListener('input', renderSuggestions);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      const first = suggestions.querySelector<HTMLButtonElement>('button');
      if (first) { event.preventDefault(); first.focus(); }
    }
    if (event.key === 'Escape') closeSuggestions();
  });

  const terrains = [
    { name: 'Cobblestone / stone', tile: 'cobblestone', friction: 100, points: [[11, 113], [12, 135], [13, 167], [14, 219], [15, 321], [16, 592], [17, 2382]] },
    { name: 'Light dirt', tile: 'heavy-dirt', friction: 110, points: [[11, 126], [12, 150], [13, 187], [14, 248], [15, 367], [16, 696], [17, 3060]] },
    { name: 'Hive / Rotten Wasteland', tile: 'heavy-dirt', friction: 125, points: [[11, 146], [12, 175], [13, 219], [14, 293], [15, 444], [16, 876], [17, 4419]] },
    { name: 'Medium dirt / mud', tile: 'heavy-dirt', friction: 140, points: [[8, 111], [9, 125], [10, 143], [11, 167], [12, 201], [13, 254], [14, 344], [15, 531], [16, 1092], [17, 6341]] },
    { name: 'Grass / gravel', tile: 'grass', friction: 150, points: [[8, 120], [9, 135], [10, 155], [11, 181], [12, 219], [13, 278], [14, 380], [15, 595], [16, 1258], [17, 8036]] },
    { name: 'Sand / snow', tile: 'sand', friction: 160, points: [[7, 116], [8, 129], [9, 145], [10, 167], [11, 196], [12, 238], [13, 304], [14, 419], [15, 663], [16, 1443], [17, 10167]] },
    { name: 'Heavy dirt', tile: 'heavy-dirt', friction: 200, points: [[4, 114], [5, 124], [6, 135], [7, 149], [8, 167], [9, 190], [10, 219], [11, 261], [12, 322], [13, 419], [14, 597], [15, 998], [16, 2444], [17, 25761]] },
    { name: 'Underwater', tile: 'underwater', friction: 250, points: [[1, 117], [2, 126], [3, 135], [4, 146], [5, 160], [6, 175], [7, 195], [8, 220], [9, 252], [10, 295], [11, 356], [12, 446], [13, 598], [14, 884], [15, 1591], [16, 4557], [17, 81351]] },
  ] as const;
  const tibiaAsset = (name: string) => new URL(`../assets/tibia/${name}`, import.meta.url).href;
  const spellIcons: Record<string, string> = {
    'No haste': tibiaAsset('citizen-male.gif'), Haste: tibiaAsset('haste.gif'), 'Strong Haste': tibiaAsset('strong-haste.gif'),
    'Swift Foot': tibiaAsset('swift-foot.gif'), Charge: tibiaAsset('charge.gif'),
  };
  document.querySelector<HTMLImageElement>('#time-ring-icon')!.src = tibiaAsset('time-ring.gif');
  document.querySelector<HTMLImageElement>('#draptor-mount-icon')!.src = tibiaAsset('draptor-mount.gif');

  type Spell = { name: string; multiplier: number };
  type Boot = { name: string; speed: number; level: number; icon: string; imbuable: boolean };
  type Imbuement = { name: string; speed: number };
  const imbuements: Imbuement[] = [
    { name: 'None', speed: 0 }, { name: 'Basic Swiftness', speed: 10 },
    { name: 'Intricate Swiftness', speed: 15 }, { name: 'Powerful Swiftness', speed: 30 },
  ];
  const bootsFor = (vocation: string): Boot[] => {
    const value = vocation.toLowerCase();
    const boots: Boot[] = [
      { name: 'No speed boots', speed: 0, level: 0, icon: '', imbuable: true },
      { name: 'Badger Boots', speed: 10, level: 60, icon: 'badger-boots.gif', imbuable: true },
      { name: 'Boots of Haste', speed: 20, level: 0, icon: 'boots-of-haste.gif', imbuable: true },
      { name: 'Void Boots', speed: 30, level: 150, icon: 'void-boots.gif', imbuable: false },
    ];
    if (value.includes('knight')) boots.push({ name: 'Cobra Boots', speed: 10, level: 220, icon: 'cobra-boots.gif', imbuable: true }, { name: 'Pair of Soulwalkers', speed: 15, level: 400, icon: 'soulwalkers.gif', imbuable: true });
    if (value.includes('paladin')) boots.push({ name: 'Prismatic Boots', speed: 15, level: 150, icon: 'prismatic-boots.gif', imbuable: true }, { name: 'Winged Boots', speed: 15, level: 220, icon: 'winged-boots.gif', imbuable: true }, { name: 'Stoic Iks Boots', speed: 15, level: 250, icon: 'stoic-iks-boots.gif', imbuable: true }, { name: 'Stag Shinguards', speed: 10, level: 350, icon: 'stag-shinguards.gif', imbuable: true });
    if (value.includes('sorcerer')) boots.push({ name: 'Sanguine Boots', speed: 10, level: 500, icon: 'sanguine-boots.gif', imbuable: true });
    if (value.includes('druid')) boots.push({ name: 'Sanguine Galoshes', speed: 10, level: 500, icon: 'sanguine-galoshes.gif', imbuable: true });
    if (value.includes('monk')) boots.push({ name: 'Soulsoles', speed: 20, level: 400, icon: 'soulsoles.gif', imbuable: true });
    return boots;
  };
  const availableSpells = (vocation: string): Spell[] => {
    const value = vocation.toLowerCase();
    const spells: Spell[] = [{ name: 'No haste', multiplier: 1 }, { name: 'Haste', multiplier: 1.3 }];
    if (/(sorcerer|druid|monk)/.test(value)) spells.push({ name: 'Strong Haste', multiplier: 1.7 });
    if (value.includes('paladin')) spells.push({ name: 'Swift Foot', multiplier: 1.8 });
    if (value.includes('knight')) spells.push({ name: 'Charge', multiplier: 1.9 });
    return spells;
  };

  const selectedSpell = () => spellOptions.querySelector<HTMLInputElement>('input:checked')?.value ?? '1';
  const selectedBoot = () => bootsFor(speedCharacter!.vocation)[Number(bootOptions.querySelector<HTMLInputElement>('input:checked')?.value ?? 0)];
  const selectedImbuement = () => imbuements[Number(imbuementOptions.querySelector<HTMLInputElement>('input:checked')?.value ?? 0)];
  const itemBonus = () => itemToggles.reduce((total, toggle) => total + (toggle.checked ? Number(toggle.dataset.speedItem) : 0), 0) + selectedBoot().speed + selectedImbuement().speed;
  const speedWith = (multiplier: number, items = itemBonus()) => {
    if (!speedCharacter) return 0;
    const base = 109 + speedCharacter.level;
    return Math.floor(multiplier * (base - 40) + 40) + items;
  };
  const breakpointAt = (points: readonly (readonly [number, number])[], speed: number) => points.filter(([, required]) => speed >= required).at(-1) ?? [0, 0];
  const adviceFor = (terrain: typeof terrains[number], speed: number, spell: Spell) => {
    const [currentBreakpoint] = breakpointAt(terrain.points, speed);
    const strongest = availableSpells(speedCharacter!.vocation).at(-1)!;
    const hasteSpeed = speedWith(strongest.multiplier);
    const [hasteBreakpoint] = breakpointAt(terrain.points, hasteSpeed);
    const imbueSpeed = speed + (30 - selectedImbuement().speed);
    const [imbueBreakpoint] = breakpointAt(terrain.points, imbueSpeed);
    if (spell.multiplier === 1 && hasteBreakpoint > currentBreakpoint) return `${strongest.name} reaches breakpoint ${hasteBreakpoint} here (${900 - hasteBreakpoint * 50} ms per tile).`;
    if (spell.multiplier === 1) return `You don't need haste here; it does not reach the next breakpoint on this tile.`;
    if (selectedBoot().imbuable && selectedImbuement().speed < 30 && imbueBreakpoint > currentBreakpoint) return `Powerful Swiftness reaches breakpoint ${imbueBreakpoint} here.`;
    if (selectedBoot().imbuable && selectedImbuement().speed < 30) return `You do not need Powerful Swiftness here; the remaining speed does not reach the next breakpoint.`;
    return `${spell.name} currently reaches breakpoint ${currentBreakpoint} here. Remove a bonus to compare alternatives.`;
  };
  const updateSpeed = () => {
    if (!speedCharacter) return;
    const spells = availableSpells(speedCharacter.vocation);
    const spell = spells.find((entry) => entry.multiplier === Number(selectedSpell())) ?? spells[0];
    const speed = speedWith(spell.multiplier);
    speedTotal.textContent = String(speed);
    speedChart.replaceChildren(...terrains.map((terrain) => {
      const [breakpoint] = breakpointAt(terrain.points, speed);
      const next = terrain.points.find(([, threshold]) => threshold > speed);
      const difference = next ? next[1] - speed : 0;
      const row = document.createElement('tr');
      row.innerHTML = `<td><span class="tile-name"><span class="tile-advice" tabindex="0" data-advice="${adviceFor(terrain, speed, spell)}"><img src="${tibiaAsset(`${terrain.tile}.gif`)}" alt="Advice for ${terrain.name}" /></span>${terrain.name}</span></td><td class="breakpoint">${breakpoint || '—'}</td><td>${breakpoint ? `${900 - breakpoint * 50} ms` : '>850 ms'}</td><td>${next ? `<span class="speed-diff away">+${difference} speed</span>` : '<span class="speed-diff max">Maximum</span>'}</td>`;
      return row;
    }));
  };
  const renderImbuementChoices = (imbuable: boolean) => {
    imbuementFieldset.disabled = !imbuable;
    imbuementOptions.replaceChildren(...imbuements.map((imbuement, index) => {
      const label = document.createElement('label');
      label.className = 'choice-option';
      label.innerHTML = `<input type="radio" name="boot-imbuement" value="${index}" ${index === 0 ? 'checked' : ''} ${imbuable ? '' : 'disabled'} /><img src="${tibiaAsset('swiftness.png')}" alt="" /><span>${imbuement.name}<small><b>+${imbuement.speed}</b> speed</small></span>`;
      return label;
    }));
  };
  const renderBootChoices = (character: Character) => {
    const boots = bootsFor(character.vocation);
    bootOptions.replaceChildren(...boots.map((boot, index) => {
      const label = document.createElement('label');
      const available = character.level >= boot.level;
      label.className = 'choice-option';
      label.innerHTML = `<input type="radio" name="speed-boots" value="${index}" ${index === 0 ? 'checked' : ''} ${available ? '' : 'disabled'} />${boot.icon ? `<img src="${tibiaAsset(boot.icon)}" alt="" />` : ''}<span>${boot.name}<small><b>+${boot.speed}</b> speed${boot.level ? ` · Lv. ${boot.level}` : ''}</small></span>`;
      return label;
    }));
    renderImbuementChoices(boots[0].imbuable);
  };
  const renderSpeedCalculator = (character: Character) => {
    speedCharacter = character;
    const spells = availableSpells(character.vocation);
    spellOptions.replaceChildren(...spells.map((spell, index) => {
      const label = document.createElement('label');
      label.className = 'spell-option';
      label.innerHTML = `<input type="radio" name="haste-spell" value="${spell.multiplier}" ${index === 0 ? 'checked' : ''} />${spellIcons[spell.name] ? `<img src="${spellIcons[spell.name]}" alt="" />` : ''}${spell.name}`;
      return label;
    }));
    renderBootChoices(character);
    updateSpeed();
  };
  spellOptions.addEventListener('change', updateSpeed);
  itemToggles.forEach((toggle) => toggle.addEventListener('change', updateSpeed));
  bootOptions.addEventListener('change', () => {
    renderImbuementChoices(selectedBoot().imbuable);
    updateSpeed();
  });
  imbuementOptions.addEventListener('change', updateSpeed);

  const setText = (id: string, value: string | number) => {
    document.querySelector<HTMLElement>(`#${id}`)!.textContent = String(value);
  };

  const maxStats = (character: Character) => {
    const vocation = character.vocation.toLowerCase();
    const levelFromEight = Math.max(0, character.level - 8);
    const hpGain = vocation.includes('knight') ? 15 : vocation.includes('paladin') ? 10 : 5;
    const manaGain = vocation.includes('knight') ? 5 : vocation.includes('paladin') ? 15 : 30;
    const capacityGain = vocation.includes('knight') ? 25 : vocation.includes('paladin') ? 20 : 10;
    return { hitpoints: 185 + levelFromEight * hpGain, mana: 90 + levelFromEight * manaGain, capacity: 470 + levelFromEight * capacityGain };
  };

  const showCharacter = (character: Character, updateSelection = true) => {
    const stats = maxStats(character);
    setText('profile-name', character.name);
    setText('profile-level', character.level);
    setText('profile-vocation', character.vocation);
    setText('profile-hp', stats.hitpoints);
    setText('profile-mana', stats.mana);
    setText('profile-capacity', stats.capacity);
    setText('profile-world', character.world);
    setText('profile-residence', character.residence);
    setText('profile-status', character.account_status);
    document.querySelector<HTMLAnchorElement>('#official-character-link')!.href = `https://www.tibia.com/community/?name=${encodeURIComponent(character.name).replace(/%20/g, '+')}`;
    document.querySelector<HTMLAnchorElement>('#guildstats-character-link')!.href = `https://guildstats.eu/character?lang=en&nick=${encodeURIComponent(character.name).replace(/%20/g, '+')}`;
    const selectedCharacter = { ...character, ...stats };
    if (updateSelection) window.dispatchEvent(new CustomEvent('tibia-character-selected', { detail: selectedCharacter }));
    lookup.hidden = true;
    profile.hidden = false;
    calculators.hidden = false;
    renderSpeedCalculator(character);
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const name = input.value.trim();
    if (!name) return;
    const submit = form.querySelector<HTMLButtonElement>('button')!;
    error.hidden = true;
    submit.disabled = true;
    submit.textContent = 'Looking up…';

    try {
      let response: Response;
      try {
        response = await fetch(`https://api.tibiadata.com/v5/character/${encodeURIComponent(name)}`);
      } catch {
        error.textContent = 'Could not reach TibiaData. Check your connection and try again.';
        error.hidden = false;
        return;
      }
      if (response.status === 404) {
        error.textContent = 'Character not found. Check the spelling and try again.';
        error.hidden = false;
        return;
      }
      if (!response.ok) {
        error.textContent = response.status === 400
          ? 'Character name is invalid. Check the spelling and try again.'
          : response.status === 502
            ? 'TibiaData is temporarily unable to retrieve character data. Try again later.'
            : `TibiaData returned an error (HTTP ${response.status}). Try again later.`;
        error.hidden = false;
        return;
      }
      let data: CharacterLookupResponse;
      try {
        data = await response.json();
      } catch {
        error.textContent = 'TibiaData returned an unexpected response. Try again later.';
        error.hidden = false;
        return;
      }
      const character = data?.character?.character as Character | undefined;
      if (!character?.name) {
        error.textContent = 'TibiaData returned an unexpected response. Try again later.';
        error.hidden = false;
        return;
      }
      const relatedNames = (data?.character?.other_characters ?? []).map((item: { name?: string }) => item.name).filter(Boolean);
      localStorage.setItem(suggestionKey, JSON.stringify([...new Set([...suggestionNames(), ...relatedNames])]));
      closeSuggestions();
      showCharacter(character);
    } catch {
      error.textContent = 'Unable to process the character data. Try again later.';
      error.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = 'Look up';
    }
  });

  const storedCharacter = () => {
    try {
      const characters = JSON.parse(localStorage.getItem('tibia-calcs:characters:v1') ?? '[]') as Character[];
      const selectedName = localStorage.getItem('tibia-calcs:selected-character:v1');
      return characters.find((character) => character.name === selectedName) ?? characters[0];
    } catch {
      return undefined;
    }
  };

  const activeCharacter = storedCharacter();
  if (activeCharacter) showCharacter(activeCharacter, false);
  else lookup.hidden = false;

  window.addEventListener('tibia-active-character-changed', (event) => {
    const character = (event as CustomEvent<Character | null>).detail;
    if (character) showCharacter(character, false);
    else {
      profile.hidden = true;
      lookup.hidden = false;
      calculators.hidden = true;
      input.focus();
    }
  });

  window.addEventListener('tibia-character-lookup-request', () => {
    error.hidden = true;
    lookup.hidden = false;
    input.focus();
  });

  const closeLookup = () => {
    lookup.hidden = true;
    closeSuggestions();
  };
  document.querySelector<HTMLButtonElement>('#lookup-close')!.addEventListener('click', closeLookup);
  lookup.addEventListener('click', (event) => {
    if (event.target === lookup) closeLookup();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !lookup.hidden) closeLookup();
  });
</script>
